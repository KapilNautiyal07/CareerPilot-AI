# Copy to .env and adjust. Never commit .env.

# --- Core
ENVIRONMENT=development                 # development | test | production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
COOKIE_SECURE=false                     # true behind HTTPS
CORS_ORIGINS=http://localhost:3000
DEMO_MODE=true

# --- Database (Docker Compose builds DATABASE_URL from POSTGRES_PASSWORD)
POSTGRES_PASSWORD=change-me
# Local development without Docker (see scripts/dev_postgres.py):
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/careerpilot
CHECKPOINTER=auto                       # auto | postgres | sqlite | memory

# --- LLM (optional). Without a key everything runs deterministically ("mock").
LLM_PROVIDER=mock                       # mock | anthropic | gemini
# Anthropic
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# Google Gemini (key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-flash-lite-latest   # used on 429 quota / 503 overload
GEMINI_THINKING_LEVEL=low                 # minimal | low | medium | high (lower = faster, cheaper)
# Shared 
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_USE_FALLBACKS=true

# --- Job research. "mock" = bundled, clearly labeled demo listings.
JOB_PROVIDERS=mock                      # comma list: mock,greenhouse,lever
GREENHOUSE_BOARDS=                      # board tokens, e.g. "airbnb,stripe" (public Job Board API)
LEVER_COMPANIES=                        # company slugs for the public Lever Postings API
JOB_STALE_AFTER_DAYS=30

# --- Interview code execution
CODE_SANDBOX=disabled                   # disabled | docker (network-less, resource-limited container)
SANDBOX_IMAGE=python:3.12-alpine
SANDBOX_TIMEOUT_SECONDS=5

# --- Uploads, retention, limits
MAX_UPLOAD_MB=5
RESUME_RETENTION_DAYS=365               # 0 disables automatic purge
WORKFLOW_RETENTION_DAYS=90
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EXPENSIVE_PER_MINUTE=6
MAX_REVISION_LOOPS=2
WORKFLOW_WORKERS=4
